#--------------------------------------------------------------------
# Production example for Vedos shared hosting
# Copy to .env on the server and fill in real values.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Trailing slash is required.
app.baseURL = 'https://vase-domena.cz/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

# Generate a unique key: php -r "echo 'hex:' . bin2hex(random_bytes(32)), PHP_EOL;"
encryption.key = hex:CHANGE_ME_GENERATE_A_NEW_KEY

# Values from Vedos / phpMyAdmin
database.default.hostname = localhost
database.default.database = CHANGE_ME
database.default.username = CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
