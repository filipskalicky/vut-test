#--------------------------------------------------------------------
# Example environment for local Docker development
# Copy to .env and adjust if needed:  cp .env.example .env
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = hex:67ad6617a0f715bcc644094f09547852aa6307ac37003f1e586f68f63f6a8d46

#--------------------------------------------------------------------
# DATABASE (Docker Compose service "db")
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = aktuality
database.default.username = aktuality
database.default.password = aktuality
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
